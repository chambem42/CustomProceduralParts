<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>CustomProceduralParts</AssemblyName>
    <RootNamespace>CustomProceduralParts</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\GameData\CustomProceduralParts\Plugins\</OutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>CS8012</NoWarn>
    <!-- ProceduralParts ships x86-tagged; KSP/Mono ignores it. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <!-- Flat folder of KSP Managed DLLs + ProceduralParts.dll. Override with -p:RefsDir=... -->
    <RefsDir Condition="'$(RefsDir)' == ''">$(MSBuildThisFileDirectory)..\.refs\</RefsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- ProceduralAbstractShape's UpdateShape / InitializeAttachmentNodes are internal abstract, so a
       shape in another assembly has to compile against a publicized ProceduralParts. -->
  <ItemGroup>
    <Publicize Include="ProceduralParts" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ProceduralParts"><HintPath>$(RefsDir)ProceduralParts.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RefsDir)Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RefsDir)UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RefsDir)UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RefsDir)UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(RefsDir)UnityEngine.InputLegacyModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(RefsDir)UnityEngine.PhysicsModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RefsDir)UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

</Project>
