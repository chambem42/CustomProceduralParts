<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Records the showcase videos (CustomProceduralParts.Showcase) in KSP with dotnet test, one test each (filter on
        the showcase's name, e.g. FullyQualifiedName~Showcase_B2Fuselage). Frames go to the results folder, or
        CPP_SHOWCASE_DIR. Same instance setup as the tests, plus showcase/ crafts.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CustomProceduralParts.Showcase\CustomProceduralParts.Showcase.csproj"
                          ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" OutputItemType="KspTestPlugin" />
    </ItemGroup>

    <ItemGroup>
        <KspMod Include="ProceduralParts" />
        <KspOverlay Include="$(PPGameData)" />
        <KspMod Include="..\..\GameData\CustomProceduralParts" />
    </ItemGroup>

    <ItemGroup>
        <!-- showcase/B2Showcase.craft: planecraft's B-2, built with build.py's body-up option (see B2Showcase.cs) -->
        <KspTestCraft Include="showcase/*.craft" />
    </ItemGroup>

    <Import Project="$(KspTestRoot)/build/KspTest.FromSource.targets" />

</Project>
